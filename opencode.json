{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "omlx": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "oMLX Local",
      "options": {
        "baseURL": "http://127.0.0.1:8000/v1",
        "apiKey": "{file:~/.config/opencode/omlx-api-key}"
      },
      "models": {
        "Qwen3-8B-4bit": {
          "name": "Qwen3 8B 4-bit",
          "limit": {
            "context": 32768,
            "output": 8192
          }
        }
      }
    }
  },
  "model": "omlx/Qwen3-8B-4bit"
}
